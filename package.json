{
  "name": "euclidraw-white-map-extension",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "check:dist": "pnpm build && git diff --exit-code -- dist/plugin.js alid.extension.json",
    "test:explore": "node scripts/check-explore.mjs",
    "test:host": "pnpm build && node scripts/check-host.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "computer-modern": "0.1.3",
    "d3-geo": "3.1.2",
    "pbf": "4.0.1",
    "polygon-clipping": "0.15.7",
    "proj4": "2.23.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "jsdom": "27.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "8.3.5"
  }
}
